{
  "expo": {
    "name": "I-NutriGuide",
    "slug": "inutriguide",
    "scheme": ["inutriguide", "pro.matchcesoir.inutriguide"],
    "version": "0.1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "pro.matchcesoir.inutriguide",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c282f04-03be-453e-ae12-5d29134c6ae3"
      }
    },
    "owner": "wakilrh"
  }
}
